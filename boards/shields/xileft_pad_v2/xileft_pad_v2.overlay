/*
 * Copyright (c) 2026 Xiphelier
 * SPDX-License-Identifier: MIT
 *
 * xileft pad v2 ― 次回発注基板向けの「正しい」ピン割り当て（27 キー + エンコーダ 3 個）
 * コントローラ: Seeed XIAO nRF52840 Plus (board: xiao_ble//zmk)
 *
 * v1 からの改善（妥協ゼロ構成）:
 *   - ROW5（スイッチ実体のなかった行）を廃止 -> 必要ピンが 17 本になり、
 *     NFC ピン (P0.09/P0.10) も電池ピン (P0.31) も一切使わない
 *   - 電池残量レポートが標準で機能する（P0.31 を空けてあるため）
 *   - uicr の NFC 開放設定も不要になった
 *   - シルク/回路図は D 番号ではなく P 番号 (P0.xx/P1.xx) で管理すること
 *     （Seeed の D17/D19 表記はソースによって食い違うため）
 *
 * ピン割り当て（P 番号が正、D 番号は参考）:
 *   COL0..COL5 = P0.02 P0.03 P0.28 P0.29 P0.04 P0.05   (D0..D5)
 *   ROW0..ROW4 = P1.11 P1.12 P1.13 P1.14 P1.15         (D6..D10)
 *   ENC1 A/B   = P0.15 / P0.19                          (D11 / D12)
 *   ENC2 A/B   = P1.01 / P1.03                          (D13 / SCK1)
 *   ENC3 A/B   = P1.05 / P1.07                          (MISO1 / MOSI1)
 *   未接続     = P0.31 (電池読み取り用に空ける),
 *                P0.09 / P0.10 (NFC, 予備パッドとして引き出し推奨)
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "../xileft_pad/xileft_pad-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>      // COL0  P0.02  (D0)
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>      // COL1  P0.03  (D1)
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>      // COL2  P0.28  (D2)
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>      // COL3  P0.29  (D3)
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>      // COL4  P0.04  (D4)
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>      // COL5  P0.05  (D5)
            ;

        row-gpios
            = <&xiao_d 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW0  P1.11  (D6)
            , <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW1  P1.12  (D7)
            , <&xiao_d 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW2  P1.13  (D8)
            , <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW3  P1.14  (D9)
            , <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW4  P1.15  (D10)
            ;
    };

    /* 論理配置は v1 と同一（QMK 版 LAYOUT の並び順、ROW5 の4キーを除く 27 キー） */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;
        map = <
        //  row 0
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
        //  row 1
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
        //  row 2
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
        //  row 3
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        //  row 4
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        //  levers
            RC(0,5) RC(1,5) RC(2,5)
        >;
    };

    /*
     * エンコーダは全て通常 GPIO（NFC/電池ピンなし）。
     * A/B は基板側でエンコーダのデータシートどおりに配線すること
     * （v1 のような A/B 入れ替えを不要にする）。
     */
    encoder_1: encoder_1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // ENC1_A  P0.15  (D11)
        b-gpios = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // ENC1_B  P0.19  (D12)
        steps = <80>;
        status = "okay";
    };

    encoder_2: encoder_2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ENC2_A  P1.01  (D13)
        b-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ENC2_B  P1.03  (SCK1)
        steps = <80>;
        status = "okay";
    };

    encoder_3: encoder_3 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ENC3_A  P1.05  (MISO1)
        b-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ENC3_B  P1.07  (MOSI1)
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2 &encoder_3>;
        triggers-per-rotation = <20>;

        enc1_config { triggers-per-rotation = <20>; };
        enc2_config { triggers-per-rotation = <40>; };
        enc3_config { triggers-per-rotation = <40>; };
    };

    /*
     * XIAO オンボードの RGB LED を zmk-rgbled-widget に渡す。
     * 実体は xiao_ble のボード定義にある gpio-leds ノードの子:
     *   led0 = 赤 P0.26 / led1 = 緑 P0.30 / led2 = 青 P0.06（すべてアクティブ Low）
     * モジュールはこの3つの alias を BUILD_ASSERT で必須にしている。
     *
     * ※ 以前ここには EXT_POWER (zmk,ext-power-generic) で緑 LED を常時点灯させる
     *   電源インジケータがあったが、同じ P0.30 を widget と取り合うため撤去した。
     *   起動時の点灯は widget の電池レベル表示が担う（conf の BATTERY_BLINK_MS）。
     */
    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };
};

/*
 * v2 は NFC ピンを使わないため、uicr の nfct-pins-as-gpios 設定は不要。
 * &vbatt も無効化しない。
 * P0.31 を基板側で空けてあるので、電池残量レポートがそのまま機能する。
 */

/* 既定 pinctrl が COL4/5 (P0.04/05)・ROW2-4 (P1.13-15) と重なるため予防的に無効化 */
&xiao_i2c {
    status = "disabled";
};

&xiao_spi {
    status = "disabled";
};
