/*
 * Copyright (c) 2026 Xiphelier
 * SPDX-License-Identifier: MIT
 *
 * xileft pad ― 左手用 31 キー + ロータリーエンコーダ 3 個
 * コントローラ: Seeed XIAO nRF52840 Plus (board: xiao_ble//zmk)
 *
 * 配線は KiCad のネット名 (COL0-5 / ROW0-5 / ROT0-5) に対応。
 * D0-D10 は &xiao_d で、D11 以降は nRF52840 のポート名で直接指定する。
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "xileft_pad-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>      // COL0  D0   P0.02
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>      // COL1  D1   P0.03
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>      // COL2  D2   P0.28
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>      // COL3  D3   P0.29
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>      // COL4  D4   P0.04
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>      // COL5  D5   P0.05
            ;

        row-gpios
            = <&xiao_d 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW0  D7   P1.12
            , <&xiao_d 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW1  D8   P1.13
            , <&xiao_d 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW2  D9   P1.14
            , <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW3  D10  P1.15
            , <&gpio0 15  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW4  D11  P0.15
            , <&gpio0 19  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW5  D12  P0.19
            ;
    };

    /*
     * QMK 版 keyboard.json の LAYOUT と同じ並び順。
     * 6x6 = 36 のうち 31 箇所を使用する。
     */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <6>;
        map = <
        //  row 0
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
        //  row 1
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
        //  row 2
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
        //  row 3
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
        //  row 4
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        //  encoder switches
            RC(5,0) RC(5,1) RC(5,2) RC(5,3)
        //  levers
            RC(0,5) RC(1,5) RC(2,5)
        >;
    };

    /*
     * ロータリーエンコーダ 3 個。
     *
     * steps は 1 回転あたりのパルス数（一般的な 20 デテント EC11 で 80）。
     * triggers-per-rotation は QMK 版の resolution から換算:
     *   enc1: resolution 4 -> 1 デテント 1 アクション -> 20
     *   enc2: resolution 2 -> 1 デテント 2 アクション -> 40
     *   enc3: resolution 2 -> 1 デテント 2 アクション -> 40
     *
     * 回転方向が逆になる場合は a-gpios と b-gpios を入れ替える。
     */
    encoder_1: encoder_1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ROT0  D13  P1.01
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ROT1  D14  P0.09 (NFC)
        steps = <80>;
        status = "okay";
    };

    encoder_2: encoder_2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // ROT2  D15  P0.10 (NFC)
        b-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // ROT3  D16  P0.31 (VBAT)
        steps = <80>;
        status = "okay";
    };

    encoder_3: encoder_3 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ROT4  D17  P1.03 ★要実測
        b-gpios = <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;   // ROT5  D18  P1.05
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1 &encoder_2 &encoder_3>;
        triggers-per-rotation = <20>;

        enc1_config { triggers-per-rotation = <20>; };
        enc2_config { triggers-per-rotation = <40>; };
        enc3_config { triggers-per-rotation = <40>; };
    };
};

/*
 * ROT1 / ROT2 が nRF52840 の NFC 兼用ピン (P0.09 / P0.10) に載っているため、
 * GPIO として開放する。UICR に一度だけ書き込まれる設定で、
 * 元に戻すにはチップの全消去が必要。
 */
&uicr {
    nfct-pins-as-gpios;
};

/*
 * ROT3 が P0.31 = 電池電圧読み取り用 ADC ピンを占有するため、
 * ボード定義側の電池センサを無効化する。
 * 電池自体は接続するが、残量レポートは行わない。
 */
&vbatt {
    status = "disabled";
};

/*
 * xiao_ble のボード定義では i2c1 と spi2 が既定で
 *   i2c1 -> P0.04 / P0.05  = COL4 / COL5
 *   spi2 -> P1.13 / P1.14 / P1.15 = ROW1 / ROW2 / ROW3
 * を握る設定になっている。素のキーボードビルドでは
 * CONFIG_I2C / CONFIG_SPI が無効なので実害は出ないが、
 * 将来 OLED やポインティングデバイスを足したときの衝突を防ぐため明示的に切る。
 */
&xiao_i2c {
    status = "disabled";
};

&xiao_spi {
    status = "disabled";
};
