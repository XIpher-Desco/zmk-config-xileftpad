/*
 * SPDX-License-Identifier: MIT
 *
 * ★ 診断専用のテストファーム。常用しないこと。
 *
 * エンコーダ 3 個の A/B 計 6 本を「ただの直接 GPIO キー」として割り当てる。
 * エンコーダを回すと、生きているピンだけが数字を打ち込む:
 *
 *   エンコーダ1 → 1 と 2   (D13 P1.01 / D14 P0.09)
 *   エンコーダ2 → 3 と 4   (D15 P0.10 / D12 P0.19 ★ジャンパ先)
 *   エンコーダ3 → 5 と 6   (D17 P1.03 / D18 P1.05)
 *
 * 「3 は出るが 4 が出ない」なら D12(P0.19) が死んでいる、というように
 * ピン単位で切り分けられる。マトリクスとエンコーダのドライバは使わない。
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &pintest_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        /* エンコーダは開放でプルアップ HIGH、接点が閉じると GND に落ちる */
        input-gpios
            = <&gpio1 1  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 1: ROT0 D13 P1.01  enc1 A
            , <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 2: ROT1 D14 P0.09  enc1 B
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 3: ROT2 D15 P0.10  enc2 A
            , <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 4: ROT3 D12 P0.19  enc2 B ★
            , <&gpio1 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 5: ROT4 D17 P1.03  enc3 A
            , <&gpio1 5  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // 6: ROT5 D18 P1.05  enc3 B
            ;
    };

    pintest_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <1>;
        map = < RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) >;
    };

    pintest_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Pin Test";
        transform = <&pintest_transform>;

        keys  //                             w    h     x     y  rot   rx   ry
            = <&key_physical_attrs 100 100    0    0    0    0    0>
            , <&key_physical_attrs 100 100  100    0    0    0    0>
            , <&key_physical_attrs 100 100  200    0    0    0    0>
            , <&key_physical_attrs 100 100  300    0    0    0    0>
            , <&key_physical_attrs 100 100  400    0    0    0    0>
            , <&key_physical_attrs 100 100  500    0    0    0    0>
            ;
    };
};

/* ROT1 / ROT2 は NFC 兼用ピン (P0.09 / P0.10) なので GPIO として開放する */
&uicr {
    nfct-pins-as-gpios;
};

&xiao_i2c { status = "disabled"; };
&xiao_spi { status = "disabled"; };
