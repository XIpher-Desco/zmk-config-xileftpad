 *
 * xileft pad キーマップ
 * QMK/Vial 版 xileft_pad_v3.layout.json（実機で編集した最新状態）から移植。
 *
 * 移植にあたって落とした機能:
 *   - RGB (WS2812 24 個 / VialRGB) ... ZMK の underglow は 4 エフェクトのみのため不採用
 *   - ゲームパッド (BTN00-BTN31)  ... ZMK に HID ゲームパッド機能がないため
 *   - OS Detection                ... 相当機能なし
 * 上記が入っていた位置は &none にしてある。
 *
 * 旧 LIGHT レイヤ (index 3) は BT レイヤに変更。
 * BASE の row 2 (&mo 3) を押している間だけ有効になる:
 *   - BT_SEL 0-4 : 接続先プロファイルの切り替え（5 デバイスまで）
 *   - BT_CLR     : 現在のプロファイルのペアリング情報を消去
 *   - OUT_USB / OUT_BLE : 出力先の強制切り替え
 *   - ind_bat / ind_con : LED で電池残量・接続状態を色表示
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
/*
 * LED ステータス表示（zmk-rgbled-widget）の behavior。
 * &ind_bat = 電池残量を色で表示 / &ind_con = 接続状態を色で表示。
 * BT プロファイル切替時の点灯はモジュールが自動でやるので、
 * キーマップ側に書くことはない。
 */
#include <behaviors/rgbled_widget.dtsi>
/*
 * スクロール速度の既定値を上書きする（ZMK 公式の作法。既定は 10）。
 * SCRL_UP / SCRL_DOWN がこの値を使うようになる。
 * 値の根拠は下の inc_dec_msc の注記を参照。
 * ※ pointing.h の include より前に書くこと（ヘッダ側が #ifndef で見ている）。
 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 64
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /*
         * QMK の LT(1, KC_MS_BTN2) 相当。
         * 標準の &lt は tap 側が &kp 固定なので、マウスボタン版を用意する。
         */
        lt_mkp: layer_tap_mouse_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        /*
         * エンコーダでホイールスクロールを送る。
         *
         * ★ tap-ms と速度値には理由がある。安易に変えないこと。
         *
         * &msc は "zmk,behavior-input-two-axis"、つまり「押している間ずっと
         * 一定速度でスクロールし続ける」時間ベースの behavior であって、
         * 1回押すと1ノッチ送るものではない。内部では 16ms (trigger-period-ms)
         * ごとに `速度 x 0.016` を積算し、1.0 を超えたぶんだけ HID に出す。
         * 離すと積算中の端数は捨てられる。
         *
         * sensor-rotate のデフォルト tap-ms は 5ms なので、最初の tick
         * (16ms) が来る前に離してしまい、スクロールが1回も出ない。
         * → tap-ms を 25ms にして tick をちょうど1回だけ通す。
         *
         * さらに既定の SCRL_UP / SCRL_DOWN は速度 10 で、1 tick あたり
         * 10 x 0.016 = 0.16 しか積算されない（1ノッチに約7 tick = 112ms 必要）。
         * → ファイル冒頭で ZMK_POINTING_DEFAULT_SCRL_VAL を 64 に上書きし、
         *   64 x 0.016 = 1.02 で 1 tick = 1ノッチちょうどにしている。
         *
         * 1デテントあたりのスクロール量を変えたい場合は、この速度ではなく
         * overlay の triggers-per-rotation を調整すること（現在 40 = 1デテント2回）。
         */
        inc_dec_msc: sensor_rotate_mouse_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <25>;
        };

        /*
         * 未使用エンコーダ用のプレースホルダ。
         * &none は #sensor-binding-cells を持たないため sensor-bindings には直接書けない。
         */
        enc_none: sensor_rotate_none {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {   // BASE
            bindings = <
                &kp LC(Z)       &kp GRAVE       &kp RC(RS(N))   &kp BSPC   // row 0
                &kp J           &kp U           &kp W           &kp M           &kp LC(D)   // row 1
                &kp U           &mo 3           &kp LC(Z)       &none           &kp Y   // row 2  (&mo 3 = 押している間 BT レイヤ)
                &lt_mkp 1 MB2   &kp S           &kp LC(Z)       &kp RC(RS(Z))   &none   // row 3
                &kp LC(H)       &mt LC(LALT) G  &mt LALT E      &mt LCTRL B     &mt LSHFT P   // row 4
                &kp G           &kp DOT         &kp COMMA   // levers
            >;

            sensor-bindings = <
                &inc_dec_kp EQUAL MINUS           // encoder 1
                &inc_dec_msc SCRL_UP SCRL_DOWN    // encoder 2 (速度は冒頭の SCRL_VAL 上書きを参照)
                &inc_dec_kp RBKT BSLH             // encoder 3
            >;
        };

        lower_layer {   // LOWER  (&lt_mkp 1 MB2 で保持)
            bindings = <
                &studio_unlock  &none           &none           &none   // row 0
                &none           &none           &none           &none           &none   // row 1
                &none           &none           &none           &none           &none   // row 2
                &none           &kp LC(X)       &kp LC(C)       &kp LC(V)       &none   // row 3
                &none           &none           &none           &none           &none   // row 4
                &none           &none           &none   // levers
            >;

            sensor-bindings = <
                &inc_dec_kp LBKT RBKT             // encoder 1
                &inc_dec_kp SQT MINUS             // encoder 2
                &enc_none                         // encoder 3
            >;
        };

        upper_layer {   // UPPER  (現状ここへ遷移するキーは未割り当て)
            bindings = <
                &none  &none  &none  &none   // row 0
                &none  &none  &none  &none  &none   // row 1
                &none  &none  &none  &none  &none   // row 2
                &none  &none  &none  &none  &none   // row 3
                &none  &none  &none  &none  &none   // row 4
                &none  &none  &none   // levers
            >;

            sensor-bindings = <
                &enc_none                         // encoder 1
                &enc_none                         // encoder 2
                &enc_none                         // encoder 3
            >;
        };

        bt_layer {   // BT (旧 LIGHT レイヤ)。BASE の &mo 3 を押している間だけ有効
            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3   // row 0: 接続先プロファイル 1-4
                &bt BT_SEL 4    &bt BT_CLR      &ind_bat        &out OUT_USB    &out OUT_BLE   // row 1: プロファイル5 / ペアリング消去 / 電池残量表示 / 出力切替
                &ind_con        &trans          &none           &none           &none   // row 2  (&ind_con = 接続状態表示、&trans = レイヤキー自身の位置)
                &none           &none           &none           &none           &none   // row 3
                &none           &none           &none           &none           &none   // row 4
                &none           &none           &none   // levers
            >;

            sensor-bindings = <
                &enc_none                         // encoder 1
                &enc_none                         // encoder 2
                &enc_none                         // encoder 3
            >;
        };

        sp1_layer {   // SP1    (未使用の予備)
            bindings = <
                &none  &none  &none  &none   // row 0
                &none  &none  &none  &none  &none   // row 1
                &none  &none  &none  &none  &none   // row 2
                &none  &none  &none  &none  &none   // row 3
                &none  &none  &none  &none  &none   // row 4
                &none  &none  &none   // levers
            >;

            sensor-bindings = <
                &inc_dec_kp LBKT RBKT             // encoder 1
                &inc_dec_kp SQT MINUS             // encoder 2
                &enc_none                         // encoder 3
            >;
        };

        sp2_layer {   // SP2    (未使用の予備)
            bindings = <
                &none  &none  &none  &none   // row 0
                &none  &none  &none  &none  &none   // row 1
                &none  &none  &none  &none  &none   // row 2
                &none  &none  &none  &none  &none   // row 3
                &none  &none  &none  &none  &none   // row 4
                &none  &none  &none   // levers
            >;

            sensor-bindings = <
                &inc_dec_kp LBKT RBKT             // encoder 1
                &inc_dec_kp SQT MINUS             // encoder 2
                &enc_none                         // encoder 3
            >;
        };
    };
};
